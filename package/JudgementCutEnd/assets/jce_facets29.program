// 三裂面专用顶点/像素合同；默认captureValid=0，在独立HDR复制成功前严格透明。
vertex_program JCE/Facet29_VP hlsl
{
    source jce_facets29.hlsl
    entry_point jce_facet29_vp
    target vs_4_0
    default_params
    {
        param_named_auto worldViewProjMatrix worldviewproj_matrix
        param_named_auto worldViewMatrix worldview_matrix
    }
}
fragment_program JCE/Facet29_FP hlsl
{
    source jce_facets29.hlsl
    entry_point jce_facet29_fp
    target ps_4_0
    default_params
    {
        param_named_auto viewport viewport_size
        param_named captureValid float 0
    }
}
