// 与本机Ogre HLSL路径一致；矩阵自动参数名必须是worldviewproj_matrix。
vertex_program JCE/Fog_VP hlsl
{
    source jce_atmosphere.hlsl
    entry_point jce_fog_vp
    target vs_4_0
    default_params
    {
        param_named_auto worldViewProjMatrix worldviewproj_matrix
    }
}
// r3使用独立像素程序名，避免沿用旧Mist程序对象；输入仍由Fog_VP提供。
fragment_program JCE/MistDisabled271_FP hlsl
{
    source jce_atmosphere.hlsl
    entry_point jce_mist_fp
    target ps_4_0
}
fragment_program JCE/Smoke_FP hlsl
{
    source jce_atmosphere.hlsl
    entry_point jce_smoke_fp
    target ps_4_0
}

// 2.8烟带/烟丝使用独立程序身份；淡蓝色与局部卷流共享原Fog_VP及四分量UV合同。
fragment_program JCE/SourceSmokeRibbon28_FP hlsl
{
    source jce_atmosphere.hlsl
    entry_point jce_source_ribbon_fp
    target ps_4_0
}
fragment_program JCE/SourceSmokeWisp28_FP hlsl
{
    source jce_atmosphere.hlsl
    entry_point jce_source_wisp_fp
    target ps_4_0
}
