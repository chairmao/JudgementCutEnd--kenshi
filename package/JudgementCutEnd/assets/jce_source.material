// 2.8淡蓝流烟Ribbon：独立512px/4×4烟形图；普通透明混合保留轮廓空隙，深度仅检测。
// 主体密度来自可平铺低频场；辅助图集仅弱调制，保留无mipmap图集槽防串格。
material JCE/SourceSmokeRibbon
{
    technique
    {
        pass
        {
            vertex_program_ref JCE/Fog_VP {}
            fragment_program_ref JCE/SourceSmokeRibbon28_FP {}
            lighting off
            depth_write off
            depth_check on
            cull_hardware none
            scene_blend alpha_blend
            texture_unit
            {
                texture jce_cloud_field27.tga
                tex_address_mode wrap
                filtering trilinear
            }
            texture_unit
            {
                texture jce_source_fog_palette.dds
                tex_address_mode clamp
                filtering trilinear
            }
            texture_unit
            {
                texture jce_source_soft_smoke.dds
                tex_address_mode clamp
                filtering linear linear none
            }
        }
    }
}

