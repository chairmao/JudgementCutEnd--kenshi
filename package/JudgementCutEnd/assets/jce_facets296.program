// 2.9.6五组UV包含出生参考位置；两个投影矩阵沿用自动参数，默认captureValid=0，旧模式跳过新映射。
vertex_program JCE/Facet296_VP hlsl
{
    source jce_facets296.hlsl
    entry_point jce_facet296_vp
    target vs_4_0
    default_params
    {
        param_named_auto worldViewProjMatrix worldviewproj_matrix
        param_named_auto worldViewMatrix worldview_matrix
    }
}
fragment_program JCE/Facet296_FP hlsl
{
    source jce_facets296.hlsl
    entry_point jce_facet296_fp
    target ps_4_0
    default_params
    {
        param_named_auto viewport viewport_size
        param_named captureValid float 0
    }
}
