// 单宽面验证专用顶点/像素合同；默认captureValid=0，在独立HDR复制成功前严格透明。
vertex_program JCE/Facet292_VP hlsl
{
    source jce_facets292.hlsl
    entry_point jce_facet292_vp
    target vs_4_0
    default_params
    {
        param_named_auto worldViewProjMatrix worldviewproj_matrix
        param_named_auto worldViewMatrix worldview_matrix
    }
}
fragment_program JCE/Facet292_FP hlsl
{
    source jce_facets292.hlsl
    entry_point jce_facet292_fp
    target ps_4_0
    default_params
    {
        param_named_auto viewport viewport_size
        param_named captureValid float 0
    }
}
