        "text": "material JCE/Glow\n{\n    technique\n    {\n        pass\n        {\n            vertex_program_ref Basic_Coloured_Texture_VP {}\n            // 原版 basic_fp 返回 texture * colour * vertexColour；HDR 增益放在浮点 uniform，\n            // 不依赖归一化顶点颜色容纳 >1，也不改游戏公共着色器；仍保留世界深度遮挡。\n            fragment_program_ref Basic_Texture_FP\n            {\n                param_named colour float4 4 4 4 1\n            }\n            lighting off\n            depth_write off\n            depth_check on\n            cull_hardware none\n            scene_blend add\n            texture_unit\n            {\n                texture jce_glow.tga\n                tex_address_mode clamp\n                colour_op modulate\n            }\n        }\n    }\n}\n\n// JCE_VFX110_BEGIN：三个独立材质段：灰雾Alpha混合、刀痕/空间裂光加法混合；不修改公共着色器。\nmaterial JCE/Mist\n{\n    technique\n    {\n        pass\n        {\n            vertex_program_ref Basic_Coloured_Texture_VP {}\n            fragment_program_ref Basic_Texture_FP\n            {\n                param_named colour float4 1 1 1 1\n            }\n            lighting off\n            depth_write off\n            depth_check on\n            cull_hardware none\n            scene_blend alpha_blend\n            texture_unit\n            {\n                texture jce_mist.tga\n                tex_address_mode clamp\n                colour_op modulate\n            }\n        }\n    }\n}\nmaterial JCE/Glass\n{\n    technique\n    {\n        pass\n        {\n            vertex_program_ref Basic_Coloured_Texture_VP {}\n            fragment_program_ref Basic_Texture_FP\n            {\n                param_named colour float4 1 1 1 1\n            }\n            lighting off\n            depth_write off\n            depth_check on\n            cull_hardware none\n            // 乘源Alpha再叠加光，确保零Alpha帧没有高光；纯add会忽略顶点Alpha。\n            scene_blend src_alpha one\n            texture_unit\n            {\n                texture jce_glass.tga\n                tex_address_mode clamp\n                colour_op modulate\n            }\n        }\n    }\n}\n\n// 独立背景副本在施放前绑定，首段绘制前完成GPU复制；仍保留世界深度遮挡和正常Alpha混合。\nmaterial JCE/Refraction\n{\n    technique\n    {\n        pass\n        {\n            vertex_program_ref Basic_Coloured_Texture_VP {}\n            fragment_program_ref JCE/Refraction_FP {}\n            lighting off\n            depth_write off\n            depth_check on\n            cull_hardware none\n            scene_blend alpha_blend\n            texture_unit\n            {\n                texture jce_glass.tga\n                tex_address_mode clamp\n                filtering bilinear\n            }\n            texture_unit\n            {\n                // 解析时占位，PrepareRefraction替换为JCE/SceneCopy；失败时本材质不提交。\n                texture jce_glow.tga\n                tex_address_mode clamp\n                filtering bilinear\n            }\n        }\n    }\n}\n"
      },
      "jce_source.material": {
        "sha256": "b0e6028297b6bd04436f760b05209047d82c9d25f0cc9d92542a30c5ce0a4e22",
        "text": "// 本机ap05原纹理层；亮度按Kenshi HDR适配，非照搬Skyrim数值。\nmaterial JCE/SourceBlade\n{\n    technique\n    {\n        pass\n        {\n            vertex_program_ref Basic_Coloured_Texture_VP {}\n            fragment_program_ref JCE/SourceTexture_FP\n            {\n                param_named hdrGain float 3\n                param_named grayscale float 0\n            }\n            lighting off\n            depth_write off\n            depth_check on\n            cull_hardware none\n            scene_blend src_alpha one\n            texture_unit\n            {\n                texture jce_source_blade09.dds\n                tex_address_mode clamp\n                filtering bilinear\n            }\n        }\n    }\n}\n// 本机ap05原纹理层；亮度按Kenshi HDR适配，非照搬Skyrim数值。\nmaterial JCE/SourceFeather\n{\n    technique\n    {\n        pass\n        {\n            vertex_program_ref Basic_Coloured_Texture_VP {}\n            fragment_program_ref JCE/SourceTexture_FP\n            {\n                param_named hdrGain float 1.6\n                param_named grayscale float 0\n            }\n            lighting off\n            depth_write off\n            depth_check on\n            cull_hardware none\n            scene_blend src_alpha one\n            texture_unit\n            {\n                texture jce_source_blade08.dds\n                tex_address_mode clamp\n                filtering bilinear\n            }\n        }\n    }\n}\n// 本机ap05原纹理层；亮度按Kenshi HDR适配，非照搬Skyrim数值。\nmaterial JCE/SourceDust\n{\n    technique\n    {\n        pass\n        {\n            vertex_program_ref Basic_Coloured_Texture_VP {}\n            fragment_program_ref JCE/SourceTexture_FP\n            {\n                param_named hdrGain float 1\n                param_named grayscale float 0\n                // 仅本烟尘材质收紧轮廓，刀光等四层使用默认0。\n                param_named dustDetail float 1\n            }\n            lighting off\n            depth_write off\n            depth_check on\n            cull_hardware none\n            scene_blend alpha_blend\n            texture_unit\n            {\n                texture jce_source_dust.dds\n                tex_address_mode clamp\n                filtering bilinear\n            }\n        }\n    }\n}\n// 本机ap05原纹理层；亮度按Kenshi HDR适配，非照搬Skyrim数值。\nmaterial JCE/SourceFlash\n{\n    technique\n    {\n        pass\n        {\n            vertex_program_ref Basic_Coloured_Texture_VP {}\n            fragment_program_ref JCE/SourceTexture_FP\n            {\n                param_named hdrGain float 3\n                param_named grayscale float 0\n            }\n            lighting off\n            depth_write off\n            depth_check on\n            cull_hardware none\n            scene_blend src_alpha one\n            texture_unit\n            {\n                texture jce_source_flash.dds\n                tex_address_mode clamp\n                filtering bilinear\n            }\n        }\n    }\n}\n// 本机ap05原纹理层；亮度按Kenshi HDR适配，非照搬Skyrim数值。\nmaterial JCE/SourceSpark\n{\n    technique\n    {\n        pass\n        {\n            vertex_program_ref Basic_Coloured_Texture_VP {}\n            fragment_program_ref JCE/SourceTexture_FP\n            {\n                param_named hdrGain float 4\n                param_named grayscale float 1\n            }\n            lighting off\n            depth_write off\n            depth_check on\n            cull_hardware none\n            scene_blend src_alpha one\n            texture_unit\n            {\n                texture jce_source_spark.dds\n                tex_address_mode clamp\n                filtering bilinear\n            }\n        }\n    }\n}\n"
      },
      "jce_source_texture.hlsl": {
        "sha256": "31fdfa2dd767d25f0c503413035bc91109e98a0f3de6e1c9d00f036afe175b55",
        "text": "// 同原有Basic_Coloured_Texture_VP接口；HDR增益独立于归一化顶点颜色。\n// 透明度同时乘原DDS Alpha与演出曲线，防止演出前后零Alpha仍发光。\nTexture2D sourceTexture : register(t0);\nSamplerState sourceSampler : register(s0);\nuniform float hdrGain;\nuniform float grayscale;\n// 仅SourceDust启用细雾轮廓；默认0使刀光、拖尾、闪光和光屑保持2.0原像素路径。\nuniform float dustDetail;\nstruct JCE_SOURCE_FRAGMENT {float4 pos:SV_Position;float4 colour:COLOR;float4 texCoord:TEXCOORD0;};\nfloat4 jce_source_texture_fp(JCE_SOURCE_FRAGMENT input):SV_Target {\n    float4 source=sourceTexture.Sample(sourceSampler,input.texCoord.xy);\n    float mask=dot(source.rgb,float3(.2126,.7152,.0722));\n    float3 colour=lerp(source.rgb,mask.xxx,saturate(grayscale));\n    float detail=1;\n    if(dustDetail>.5){\n        // 使用原8x8图集Alpha提取稠密细丝，压低低密度灰底；不扭曲UV、不采样邻格。\n        // 局部边缘柔化避免拉长后的雾片露出矩形边界；动画和流向由各独立粒子时钟/刀路提供。\n        float2 local=frac(input.texCoord.xy*8);\n        float edge=min(min(local.x,1-local.x),min(local.y,1-local.y));\n        float core=smoothstep(.025,.32,source.a);\n        detail=(.25+.75*core)*smoothstep(0,.10,edge);\n    }\n    return float4(colour*input.colour.rgb*hdrGain,source.a*input.colour.a*detail);\n}\n"
      },
      "jce_source_texture.program": {
        "sha256": "e19c82f7a9a0aad7d443b6ef0e546defb1bb3e9bc85decc8203ee3c436071810",
        "text": "// 原纹理专用shader；只在本插件资源组使用，不覆盖游戏Basic_*程序。\nfragment_program JCE/SourceTexture_FP hlsl\n{\n    source jce_source_texture.hlsl\n    entry_point jce_source_texture_fp\n    target ps_4_0\n    default_params\n    {\n        param_named hdrGain float 1\n        param_named grayscale float 0\n        // 缺省关闭细雾处理，兼容原刀光/闪光/光屑材质。\n        param_named dustDetail float 0\n    }\n}\n"
      }
    }
  },
